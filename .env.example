# Free LLM providers (any one is enough; local Ollama needs no key)
GROQ_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
OLLAMA_URL=http://localhost:11434
# Direct access to Ollama cloud models (leave OLLAMA_URL empty to use it)
OLLAMA_API_KEY=

# Optional paid provider
ANTHROPIC_API_KEY=

# Langfuse (self-hosted via docker-compose, or cloud)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://localhost:3000

# Warehouse location (defaults to data/warehouse.duckdb; CI uses the sample)
FRONT_OFFICE_DB=data/warehouse.duckdb

# Hugging Face token with write access, for deploy/hf_space.py
HF_TOKEN=

# Docker overrides (see docker-compose.yml)
FRONT_OFFICE_DOCKER_DB=/warehouse/warehouse.duckdb
FRONT_OFFICE_DEMO_LIMIT=0
